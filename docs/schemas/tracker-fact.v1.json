{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/tracker-fact.v1.json",
  "title": "TrackerFactV1",
  "description": "前端与 API 消费的最终事实契约。status 与 confidence 由服务端计算，不由模型输出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tracker_id",
    "subject",
    "status",
    "freshness",
    "times",
    "key_facts",
    "milestones",
    "sources",
    "confidence",
    "quality",
    "run",
    "version"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tracker_id": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "region", "platform"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": ["game_event", "sale", "preorder", "maintenance", "season", "other"]
        },
        "region": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["upcoming", "active", "ended", "unknown"],
      "description": "服务端根据 end_at 与当前时间计算"
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "error"]
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "timezone", "precision", "raw_text"],
      "properties": {
        "start_at": { "type": ["string", "null"] },
        "end_at": { "type": ["string", "null"] },
        "timezone": { "type": "string" },
        "precision": {
          "type": "string",
          "enum": ["exact", "minute", "date", "month", "relative", "unknown"]
        },
        "raw_text": { "type": "string" }
      }
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "at", "raw_text"],
        "properties": {
          "label": { "type": "string" },
          "at": { "type": ["string", "null"] },
          "raw_text": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "publisher",
          "is_official",
          "found_via",
          "published_at",
          "fetched_at",
          "quote"
        ],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "publisher": { "type": ["string", "null"] },
          "is_official": { "type": "boolean" },
          "found_via": {
            "type": "string",
            "enum": ["search", "direct_url", "manual_paste"]
          },
          "published_at": { "type": ["string", "null"] },
          "fetched_at": { "type": "string" },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "time", "basis"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "time": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needs_review", "review_reason", "conflicts"],
      "properties": {
        "needs_review": { "type": "boolean" },
        "review_reason": { "type": ["string", "null"] },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "values"],
            "properties": {
              "field": { "type": "string" },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_searched_at",
        "last_checked_at",
        "last_changed_at",
        "next_check_at",
        "consecutive_failures"
      ],
      "properties": {
        "last_searched_at": { "type": ["string", "null"] },
        "last_checked_at": { "type": ["string", "null"] },
        "last_changed_at": { "type": ["string", "null"] },
        "next_check_at": { "type": ["string", "null"] },
        "consecutive_failures": { "type": "integer", "minimum": 0 }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_version", "model", "prompt_version"],
      "properties": {
        "fact_version": { "type": "integer", "minimum": 1 },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
