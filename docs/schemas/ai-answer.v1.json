{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitracking.local/schemas/ai-answer.v1.json",
  "title": "AI Answer Ingestion v1",
  "description": "AI 完成全网搜索后提交给服务端的固定回答格式。服务端保留原始回答，校验后写入当前事实。",
  "type": "object",
  "required": ["subject", "times", "sources"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai-answer.v1"
    },
    "subject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": {
          "type": "string",
          "enum": ["game_event", "sale", "preorder", "maintenance", "season", "other"]
        },
        "region": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] }
      }
    },
    "times": {
      "type": "object",
      "properties": {
        "start_at": {
          "type": ["string", "null"],
          "description": "ISO 8601 带时区偏移，例如 2026-12-04T03:59:59+08:00"
        },
        "end_at": {
          "type": ["string", "null"],
          "description": "ISO 8601 带时区偏移；找不到时填 null，禁止猜测"
        },
        "timezone": { "type": "string", "default": "Asia/Shanghai" },
        "precision": {
          "type": "string",
          "enum": ["exact", "minute", "date", "month", "relative", "unknown"]
        },
        "raw_text": {
          "type": "string",
          "description": "原文中描述时间的句子，必须逐字保留，供 grounding 校验"
        }
      }
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "at": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": ["string", "null"] },
          "quote": {
            "type": ["string", "null"],
            "description": "逐字引用，结束时间必须能在这里或 times.raw_text 中核对"
          },
          "published_at": { "type": ["string", "null"] },
          "is_official": { "type": "boolean", "default": false }
        }
      }
    },
    "confidence": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        {
          "type": "object",
          "properties": {
            "overall": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "notes": { "type": ["string", "null"] },
    "ambiguities": { "type": "array", "items": { "type": "string" } }
  }
}
